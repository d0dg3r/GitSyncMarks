# GitSyncMarks E2E test credentials.
# Copy to .env and fill in values. .env is gitignored.
#
# Create the GitHub test repo once:
#   GITSYNCMARKS_GITHUB_PAT=ghp_xxx node scripts/create-test-repo.js --host=github
#
# Create the Forgejo fixture repo once (Homelab default):
#   node scripts/create-test-repo.js --host=forgejo
#
# npm run test:onboarding-scale uses --ensure-repo: deletes GITSYNCMARKS_GITHUB_REPO if it exists,
# then recreates it. Classic PATs need the delete_repo scope; fine-grained tokens need
# Administration: delete + create on that repository (or use a dedicated disposable repo name).
#
# Forgejo Actions CI uses the same names: tokens as Secrets, owner/repo/URL as Variables.
# Secret names must not start with GITHUB_, FORGEJO_, or GITEA_ (Forgejo restriction).

GITSYNCMARKS_GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITSYNCMARKS_GITHUB_OWNER=your-github-username
GITSYNCMARKS_GITHUB_REPO=GitSyncMarks-test-sync

# Forgejo onboarding / dual-host E2E (npm run test:e2e:onboarding)
# Homelab default; override SERVER_URL for another instance. Token needs repo create/delete + contents.
# Stable fixture name matches GitHub; ephemeral repos use prefix gitsyncmarks-e2e- (auto-cleaned).
GITSYNCMARKS_FORGEJO_TOKEN=
GITSYNCMARKS_FORGEJO_OWNER=
GITSYNCMARKS_FORGEJO_REPO=GitSyncMarks-test-sync
GITSYNCMARKS_FORGEJO_SERVER_URL=https://forgejo.lan

# Optional: GitHub PAT used only by Forgejo release.yml to copy ZIPs to github.com/d0dg3r/GitSyncMarks
# (set as Forgejo Actions secret GITSYNCMARKS_RELEASE_PAT; not required for local E2E)
# GITSYNCMARKS_RELEASE_PAT=

# Gitea / Codeberg sync performance benchmark (npm run test:gitea-benchmark)
# Alternative: ~/.secrets.sh with export GITSYNCMARKS_GITEA_* (script loads that file too).
# Use a disposable repo or --read-only / small --write-count for write tests.
# Separate from Forgejo E2E vars above so Codeberg benchmark and Forgejo onboarding do not collide.
GITSYNCMARKS_GITEA_TOKEN=
GITSYNCMARKS_GITEA_OWNER=
GITSYNCMARKS_GITEA_REPO=
GITSYNCMARKS_GITEA_SERVER_URL=https://codeberg.org
GITSYNCMARKS_GITEA_PROVIDER=codeberg
GITSYNCMARKS_GITEA_BRANCH=main
GITSYNCMARKS_GITEA_BASE_PATH=bookmarks
